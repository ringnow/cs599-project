# CS599 AI Research Agent v2 - Environment Configuration
# API keys are stored securely in ~/.cs599-agent/ (encrypted)
# Set keys here for development, or use the UI to configure

# DeepSeek API (default)
DEEPSEEK_API_KEY=your_deepseek_key

# OpenAI API (optional)
# OPENAI_API_KEY=your_openai_key

# SiliconFlow API (optional)
# SILICONFLOW_API_KEY=your_siliconflow_key

# Ollama (local models - no key needed)
# OLLAMA_HOST=http://localhost:11434

# Optional: LangSmith tracing
# LANGCHAIN_API_KEY=your_langsmith_key
# LANGCHAIN_PROJECT=cs599-research-agent

# ─── 数据库 / 缓存 / 队列 ───────────────────────────────────
# 数据库连接：默认 SQLite，生产用 MySQL
# SQLite（本地开发默认）:  sqlite:///cs599_history.db
# MySQL:                   mysql+pymysql://user:pass@host:3306/dbname?charset=utf8mb4
DATABASE_URL=sqlite:///cs599_history.db

# Redis 缓存 + 异步队列（不设则自动降级，缓存和队列功能不可用）
REDIS_URL=redis://localhost:6379/0

# ─── 认证 / 安全 ─────────────────────────────────────────────
# JWT 密钥（生产环境必须改成强随机字符串！至少32字符）
JWT_SECRET_KEY=cs599-dev-jwt-secret-key-change-in-real-production-2026-a1b2c3

# bcrypt 加密轮数（OWASP 推荐 10，默认 10；压测可降到 4）
BCRYPT_ROUNDS=10

# 默认 admin 密码（不设则不创建默认 admin 用户，需自行注册）
# DEFAULT_ADMIN_PASSWORD=your_admin_password

